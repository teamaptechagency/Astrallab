# What does not belong in a deployment.
#
# storage/ is deliberately NOT here. Only the empty directory skeleton is in
# the repository, and composer install runs artisan package:discover, which
# boots the application — with no storage/framework directories that build
# fails before it starts. At runtime the storage path points at /tmp instead
# (see api/index.php), so what ships is a skeleton nothing writes to.

# The shipped archives and the self-update machinery: all about replacing files
# on a disk this host does not have. A new version arrives here by deploying.
*.zip
deploy/

tests/
node_modules/

.env
.env.*
!.env.example

# A shared-hosting diagnostic: "which copy of the app is actually running?".
# There is only ever one copy here, and it has no business being reachable.
public/where.php
