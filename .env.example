# SQLite for the prototype. Swap provider in prisma/schema.prisma for Postgres.
DATABASE_URL="file:./dev.db"

# Generate every value below with: npx tsx scripts/generate-keys.ts

# Keys the HMAC that protects licence keys at rest. Changing it invalidates
# every issued licence — they can no longer be looked up.
LICENCE_SECRET=

# Shared secret the WooCommerce store signs its licence-issue calls with.
STORE_API_SECRET=

# Signs time-limited package download links.
PACKAGE_URL_SECRET=

# Ed25519 private key used to sign responses to CMS installs. The matching
# PUBLIC key is baked into the CMS. Never ships to customers.
SIGNING_PRIVATE_KEY=
