# manage.astrallabs.uk — production settings.
#
# Copy to .env on the server and fill in. Every value below is a secret except
# the two URLs; none of them may be committed, and none should travel by email
# or chat.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite on a VPS with a persistent disk is a reasonable choice at this scale:
# one file, no second service to run or back up separately, and this workload is
# thousands of small reads a day rather than heavy concurrent writes.
#
# The absolute path matters. A relative one resolves against the working
# directory, which is not the same under PM2 as it is in your shell — and the
# result is a second, empty database that looks like every licence vanishing.
DATABASE_URL="file:/var/www/manage/data/production.db"

# ---------------------------------------------------------------------------
# Keys
# ---------------------------------------------------------------------------
# Generate with: npm run keys:generate
#
# SIGNING_PRIVATE_KEY is the one that cannot be replaced. Its public half is
# compiled into every copy of the CMS ever shipped; lose it and no installed
# shop will believe anything this hub says, and the only fix is rebuilding and
# reshipping the CMS to all of them. Back it up somewhere off this server.
SIGNING_PRIVATE_KEY=

# Keys the HMAC that protects licence keys at rest. Change it and every issued
# licence becomes unlookupable — the keys customers hold stop matching anything.
LICENCE_SECRET=

# Shared with the WooCommerce plugin. Must match its "API secret" setting
# exactly, or the store gets a 401 on every attempt to issue a licence and
# nobody who pays receives one.
STORE_API_SECRET=

# Signs the time-limited download links handed to installs.
PACKAGE_URL_SECRET=

# Signs operator session cookies. Changing it signs everybody out, which is
# also how you sign everybody out.
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Addresses
# ---------------------------------------------------------------------------
NEXT_PUBLIC_HUB_URL=https://manage.astrallabs.uk

# How many licences the store may issue per hour. A stolen STORE_API_SECRET
# with no ceiling is an unlimited supply of free licences.
ISSUE_RATE_LIMIT_PER_HOUR=60

NODE_ENV=production
PORT=3200
