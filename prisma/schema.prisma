// manage.astralab.com — licence, activation and update hub.
//
// SQLite for the prototype (zero setup, runs anywhere). Swapping to Postgres
// is a provider change here plus a connection string; the schema deliberately
// avoids anything SQLite-only — status fields are documented Strings rather
// than enums, matching how the Ayojon schema handles the same problem.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A thing sold on astralab.com. One row per sellable product (the CMS today,
// premium themes and modules later).
model Product {
  id          String   @id @default(cuid())
  // Stable machine key the installer sends, e.g. "astralab-cms". Set on the
  // matching WooCommerce product too — that pairing is what makes a sale
  // issue the right licence. Never change it once anything is sold: every
  // install in the field sends this string on every request.
  slug        String   @unique
  name        String
  // Internal note. Never leaves the console.
  description String   @default("")
  // Customer-facing copy, served by the public catalogue API that
  // astralab.com renders from. Separate from `description` so an internal
  // remark can never end up on the storefront by accident.
  summary     String   @default("")
  // Retired products keep working for existing installs — activation and
  // updates still function — but the store should stop selling them. Nothing
  // is ever deleted, because licences reference it forever.
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  releases Release[]
  licences Licence[]
}

// A published version of a product. The installer and the updater both read
// these: the installer takes the newest, the updater walks the path from the
// install's current version upward.
model Release {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Semver, e.g. "1.4.2".
  version   String
  // channel: stable | beta
  channel   String   @default("stable")
  // severity: normal | security — security releases shorten the client's
  // check interval and show a persistent warning rather than a banner.
  severity  String   @default("normal")
  notes     String   @default("")
  // Where the package actually lives. Never handed to a client directly —
  // clients receive a signed, expiring link derived from this.
  packageUrl String
  // SHA-256 of the package, so the installer can verify what it downloaded
  // before extracting it over a live site.
  checksum   String
  sizeBytes  Int      @default(0)
  // Lowest version that can jump straight to this one. Anything older has to
  // come up through the intermediate releases so migrations run in order.
  minUpgradeFrom String?
  // Unpublished releases are invisible to clients — staging area for uploads.
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([productId, version])
  @@index([productId, published])
}

// A purchase. Issued by the WooCommerce store the moment an order is paid.
//
// The key itself is never stored — only its HMAC, exactly like a session
// token. A dump of this table cannot be turned back into working keys. The
// last four characters are kept separately so support can identify a licence
// a customer reads out over the phone.
model Licence {
  id        String  @id @default(cuid())
  keyHash   String  @unique
  keyLast4  String
  productId String
  product   Product @relation(fields: [productId], references: [id])

  // Where the sale came from. The pair is unique so a webhook delivered twice
  // — which WooCommerce does routinely — cannot mint a second licence.
  orderRef   String
  orderSource String @default("woocommerce")

  customerEmail String
  customerName  String?

  // What the customer actually paid, as reported by the store at issue time.
  // Kept here so revenue reporting is derived from real orders rather than
  // multiplying a licence count by today's list price — which would silently
  // rewrite history every time the price changes.
  amount   Float?
  currency String @default("BDT")

  // status: unactivated | active | deactivated | suspended | revoked
  //
  // unactivated — paid, never bound to a domain
  // active      — bound to one production domain
  // deactivated — released by the customer, free to bind elsewhere
  // suspended   — payment dispute or abuse; reversible, admin review
  // revoked     — refund or fraud; terminal
  status String @default("unactivated")
  // Why a human changed the status. Surfaced to the customer for suspended
  // and revoked so the message isn't just a dead end.
  statusNote String?

  // How many production domains may be bound at once. One, per the sales
  // terms; stored rather than hardcoded so a multi-site tier can exist later
  // without a migration.
  seatLimit Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activations Activation[]
  events      LicenceEvent[]
  ayojonLinks AyojonLink[]
  reports     Report[]
  products    SyncedProduct[]
  leads       Lead[]

  @@unique([orderSource, orderRef])
  @@index([customerEmail])
}

// A licence bound to one domain. Released rows are kept rather than deleted
// so the transfer history stays auditable — repeated hopping between domains
// is the main abuse signal there is.
model Activation {
  id        String  @id @default(cuid())
  licenceId String
  licence   Licence @relation(fields: [licenceId], references: [id], onDelete: Cascade)

  // Normalised host only — no scheme, no www, no trailing slash, lowercased.
  // Normalisation happens before storage so "https://WWW.Shop.com/" and
  // "shop.com" can never occupy two seats.
  domain String

  releasedAt DateTime?
  // Version and environment the install last reported. Populated by the
  // heartbeat, used by support and by the update path calculation.
  lastVersion String?
  phpVersion  String?
  lastSeenAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())

  ayojonLinks AyojonLink[]

  @@index([licenceId])
  @@index([domain])
}

// Append-only audit of everything that happened to a licence. Support and
// abuse review both run off this; nothing here is ever updated in place.
model LicenceEvent {
  id        String  @id @default(cuid())
  licenceId String
  licence   Licence @relation(fields: [licenceId], references: [id], onDelete: Cascade)
  // kind: issued | activated | deactivated | blocked | downloaded | status_changed
  kind      String
  domain    String?
  detail    String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([licenceId, createdAt])
  @@index([kind, createdAt])
}

// ---------------------------------------------------------------------------
// Support
// ---------------------------------------------------------------------------

// A bug report or feedback item submitted from inside a customer's CMS.
//
// Submitted with the licence key, so every report arrives already knowing which
// customer, which domain and which version it came from — the three questions
// support otherwise spends the first two replies asking.
model Report {
  id        String  @id @default(cuid())
  licenceId String?
  licence   Licence? @relation(fields: [licenceId], references: [id], onDelete: SetNull)

  domain String?
  // kind: bug | feedback | question
  kind   String  @default("bug")
  subject String
  body    String

  // Environment captured automatically. Free text — it is whatever the install
  // reported and must never be trusted for authorisation.
  cmsVersion String?
  phpVersion String?

  // status: open | investigating | resolved | closed
  status   String  @default("open")
  // severity: low | normal | high | critical
  severity String  @default("normal")
  // Version the fix shipped in, once there is one.
  fixedIn  String?
  response String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([licenceId])
}

// ---------------------------------------------------------------------------
// Data synced from customer stores
// ---------------------------------------------------------------------------

// A product from a customer's shop.
//
// Pushed by the install, never pulled — customer sites sit on shared hosting
// with no inbound access. Image URLs point back at the customer's own server
// rather than being copied, which keeps storage cost near zero.
model SyncedProduct {
  id        String  @id @default(cuid())
  licenceId String
  licence   Licence @relation(fields: [licenceId], references: [id], onDelete: Cascade)
  domain    String

  // The product's id in the customer's own database. Unique per licence so a
  // re-sync updates rather than duplicating.
  externalId String
  name       String
  price      Float?
  currency   String  @default("BDT")
  stock      Int?
  imageUrl   String?
  url        String?
  category   String?

  syncedAt DateTime @default(now())

  @@unique([licenceId, externalId])
  @@index([licenceId])
  @@index([name])
}

// A lead captured on a customer's shop.
//
// This is personal data belonging to the customer's customers — people who
// have no relationship with Astra Lab. It is only ever stored for installs
// that explicitly opted in (see AyojonLink.scopes and the store's consent
// setting); the sync endpoint refuses it otherwise.
model Lead {
  id        String  @id @default(cuid())
  licenceId String
  licence   Licence @relation(fields: [licenceId], references: [id], onDelete: Cascade)
  domain    String

  externalId String
  name       String?
  phone      String?
  email      String?
  // source: order | enquiry | newsletter | abandoned_cart
  source     String  @default("enquiry")
  note       String?
  capturedAt DateTime

  syncedAt DateTime @default(now())

  @@unique([licenceId, externalId])
  @@index([licenceId])
}

// ---------------------------------------------------------------------------
// Finance
// ---------------------------------------------------------------------------

// Manually recorded money in and out.
//
// Licence sales are NOT stored here — they are derived from Licence.amount, so
// the two can never disagree. This table is for everything the hub cannot know
// by itself: hosting bills, contractor payments, refunds, ad spend.
model Transaction {
  id     String @id @default(cuid())
  // kind: income | expense
  kind   String
  amount Float
  currency String @default("BDT")
  // category: hosting | salary | marketing | refund | tools | other
  category String @default("other")
  note     String?
  occurredAt DateTime
  createdAt  DateTime @default(now())

  @@index([occurredAt])
  @@index([kind, occurredAt])
}

// ---------------------------------------------------------------------------
// Future Ayojon integration — deliberately dormant
// ---------------------------------------------------------------------------

// Runtime switches the hub owns, so behaviour can change without a deploy.
// The one that matters today is `ayojon.status`: every CMS install asks the
// hub whether Ayojon exists yet, and shows "coming soon" or a connect button
// based on the answer. That means Ayojon can be switched on for everyone from
// here, with no update shipped to a single customer site.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// The link between one CMS install and one Ayojon account.
//
// Nothing writes to this yet — Ayojon has no API to connect to. It exists now
// so the shape is settled while it is still free to change: once thousands of
// installs are live, adding an integration means a schema migration and a
// CMS update rolled out to all of them.
//
// The design follows the agreed policy: one Ayojon account may link many
// stores, each store keeps its own licence, and the user chooses what syncs.
model AyojonLink {
  id           String     @id @default(cuid())
  licenceId    String
  licence      Licence    @relation(fields: [licenceId], references: [id], onDelete: Cascade)
  activationId String?
  activation   Activation? @relation(fields: [activationId], references: [id])

  // Opaque identifiers from Ayojon's side. Not foreign keys — Ayojon is a
  // separate system with its own database.
  ayojonUserId     String
  ayojonBusinessId String?

  // Comma-separated consent scopes the user actually granted, e.g.
  // "products,inventory". Absent means denied — never assume a default, since
  // this governs whose data moves where.
  scopes String @default("")

  // Short-lived access token plus refresh, stored hashed for the same reason
  // licence keys are: a dump of this table must not yield working credentials.
  accessTokenHash  String?
  refreshTokenHash String?
  expiresAt        DateTime?

  connectedAt DateTime  @default(now())
  revokedAt   DateTime?
  lastSyncAt  DateTime?

  @@unique([licenceId, ayojonUserId])
  @@index([ayojonUserId])
}
